{
  "name": "saas-demo",
  "type": "saas-demo",
  "description": "Screen-recording demo: browser/phone frames, UI zooms, focus rings, captions.",
  "inputDirs": [
    "screen-recordings",
    "footage",
    "audio",
    "images"
  ],
  "files": [
    "timeline.json",
    "NOTES.md"
  ],
  "project": {
    "output": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "loudness": -14,
      "subtitles": [
        "srt",
        "vtt"
      ]
    },
    "production": {
      "method": "timeline",
      "timeline": "timeline.json"
    }
  }
}
